# =============================================================================
# MilestoneMate AI - environment template.  COPY to .env and fill in.  NEVER COMMIT .env
# Frontend variables (VITE_*) are PUBLIC at build time: never put secrets in them.
# =============================================================================

# ---------- App ----------
APP_ENV=local                         # local | staging | production
APP_BASE_URL=http://localhost:8000    # public URL of the backend (used for links/webhook docs)
FRONTEND_BASE_URL=http://localhost:5173   # PayPal return/cancel URLs are built from this
CORS_ORIGINS=http://localhost:5173    # comma-separated allowlist
LOG_LEVEL=INFO

# ---------- Database ----------
DATABASE_URL=postgresql+psycopg://mm:mm@localhost:5432/milestonemate

# ---------- Auth ----------
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_MINUTES=60

# ---------- Uploads ----------
MAX_UPLOAD_MB=5
MAX_FILES_PER_SUBMISSION=5

# ---------- AI ----------
AI_MODE=mock                          # mock | live   (mock needs no keys)
LLM_PROVIDER=gemini                   # gemini | anthropic
GEMINI_API_KEY=
GEMINI_MODEL=                         # Day-1: set to the current Flash-class model from the Gemini API models page
ANTHROPIC_API_KEY=                    # optional alternative provider
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
AI_CALLS_PER_USER_PER_HOUR=20

# ---------- PayPal (SANDBOX ONLY) ----------
PAYMENTS_MODE=mock                    # mock | paypal_sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=                    # from the webhook you register in the PayPal Developer Dashboard
PAYEE_MODE=demo_merchant              # demo_merchant | direct_payee  (decided by the Day-1 spike, doc 07)
PAYPAL_BRAND_NAME=MilestoneMate AI
ALLOW_UNVERIFIED_WEBHOOKS_IN_MOCK=false   # honoured ONLY when PAYMENTS_MODE=mock

# ---------- Seed / demo ----------
SEED_DEMO_DATA=false                  # true only for local/staging demo data

# ---------- Frontend (build-time, public) ----------
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCKS=false
